#!/usr/bin/env bash
# install — add/remove/list shared skills and plugins from GitHub repos
# Usage:
#   ./install                           Interactive picker for everything in this repo
#   ./install get --group all           Non-interactive install of a group (or named items)
#   ./install add garrytan/gstack       Clone a GitHub repo and pick items
#   ./install list                      Show installed skills and plugins
#   ./install remove <name>             Remove an installed skill or plugin
#   ./install update [user/repo]        Pull latest for one or all repos
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$ROOT_DIR/lib"

# shellcheck source=lib/core.sh
source "$LIB_DIR/core.sh"
# shellcheck source=lib/picker.sh
source "$LIB_DIR/picker.sh"
# shellcheck source=lib/commands.sh
source "$LIB_DIR/commands.sh"
# shellcheck source=lib/profiles.sh
source "$LIB_DIR/profiles.sh"
# shellcheck source=lib/mcp.sh
source "$LIB_DIR/mcp.sh"

# ── main ─────────────────────────────────────────────────────────────

usage() {
  echo ""
  echo -e "${BOLD}Usage:${RESET} ./install [command] [args]"
  echo ""
  echo -e "${BOLD}Commands:${RESET}"
  echo "  (none)               Interactive picker — install skills/plugins to ~/.claude/"
  echo "  setup [profile]      Install a profile (profiles.json): skills/plugins + mcp + auth"
  echo "  get <name...>        Non-interactive install of named items or a --group"
  echo "  add <user/repo>      Clone a GitHub repo and pick skills/plugins to add"
  echo "  mcp [list|deps|get]  Manage MCP servers (mcp/*.group.json), user scope"
  echo "  list                 Show installed skills and plugins"
  echo "  remove <name>        Remove an installed skill or plugin"
  echo "  clean                Remove every skill + plugin this repo installed into ~/.claude"
  echo "  update [user/repo]   Pull latest for one or all repos"
  echo ""
  echo -e "${BOLD}Examples:${RESET}"
  echo "  ./install                       # pick from everything in this repo"
  echo "  ./install get --group all       # install every first-party item (user scope)"
  echo "  ./install get notify awake      # install specific items non-interactively"
  echo "  ./install add garrytan/gstack   # add skills from a GitHub repo"
  echo "  ./install list"
  echo "  ./install remove review"
  echo "  ./install update"
  echo ""
}

case "${1:-}" in
  "")     cmd_default ;;
  get)    shift; cmd_get "$@" ;;
  add)    shift; cmd_add "$@" ;;
  mcp)    shift; cmd_mcp "$@" ;;
  setup)  shift; cmd_setup "$@" ;;
  list)   cmd_list ;;
  remove) shift; cmd_remove "$@" ;;
  clean)  cmd_clean ;;
  update) shift; cmd_update "$@" ;;
  -h|--help|help) usage ;;
  *)      usage; exit 1 ;;
esac
