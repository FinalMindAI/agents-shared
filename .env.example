# agents-shared MCP secrets — copy to .env (gitignored) and fill in.
# Loaded by mcp/with-env for every stdio MCP server. Each value may be a literal
# or a 1Password reference resolved at launch:  op://<vault>/<item>/<field>
# Use each server's OWN expected variable name (no remapping happens).

# ── slack (slack-mcp-server) ────────────────────────────────────────────────
# Slack user OAuth token (xoxp-…). Already registered at user scope on this
# machine via ${SLACK_MCP_TOKEN}; only needed here if you re-register slack.
# SLACK_MCP_XOXP_TOKEN=op://Private/slack-mcp/xoxp-token

# ── aws-mcp (mcp-proxy-for-aws) ─────────────────────────────────────────────
# AWS profile name — NOT a secret; must exist in ~/.aws/config and be SSO-logged-in.
AWS_PROFILE=quovy-readonly

# ── gmail (@shinzolabs/gmail-mcp) ───────────────────────────────────────────
# Absolute paths (no ~) to the OAuth client + minted credentials. One-time setup:
#   1. Google Cloud project → enable Gmail API → create Desktop OAuth client
#   2. Download the client JSON to GMAIL_OAUTH_PATH
#   3. Run the server's auth flow once → mints GMAIL_CREDENTIALS_PATH (refresh token)
#      with scopes gmail.modify + gmail.settings.basic
# GMAIL_OAUTH_PATH=/Users/you/.gmail-mcp/gcp-oauth.keys.json
# GMAIL_CREDENTIALS_PATH=/Users/you/.gmail-mcp/credentials.json

# ── azure ───────────────────────────────────────────────────────────────────
# No token here — authenticates via `az login`.

# ── datadog ─────────────────────────────────────────────────────────────────
# No token here — hosted http server, OAuth completed via `/mcp` in Claude Code.
